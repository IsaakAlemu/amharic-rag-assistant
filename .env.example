# LLM Provider: 'gemini' (recommended) or 'groq'
LLM_PROVIDER=gemini

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Models (Defaults to gemini-3.6-flash if provider is gemini; llama-3.3-70b-versatile if groq)
LLM_MODEL=gemini-3.6-flash
REWRITE_MODEL=gemini-3.6-flash
EMBED_MODEL=intfloat/multilingual-e5-small

# Retrieval
TOP_K=3
TEMPERATURE=0.1

# Paths
DATA_PATH=data/raw/train_data.json
CHROMA_PATH=chroma_db

# Limits
MAX_QUERY_CHARS=1000
LOG_LEVEL=INFO

# Evaluation
SPLITS_DIR=data/splits
HOLDOUT_RATIO=0.2
SPLIT_SEED=42
EVAL_CHROMA_PATH=chroma_db_train
JUDGE_MODEL=gemini-3.6-flash

# Model comparison (Phase 3)
LLM_MODEL_8B=llama-3.1-8b-instant
LLM_MODEL_70B=llama-3.3-70b-versatile
# MAX_PROMPT_TOKENS=5500
CONTEXT_STRATEGY=baseline

# Conversational RAG (Phase 4)
REWRITE_MODEL=llama-3.1-8b-instant
MAX_HISTORY_TURNS=6
MAX_HISTORY_TOKENS=800
